# Passphrase della pagina di login
APP_PASSPHRASE=cambiami
# Firma del cookie di sessione: stringa casuale lunga, es. `openssl rand -hex 32`
SESSION_SECRET=
# Durata della sessione in giorni
SESSION_DAYS=30

# Sviluppo locale (npm run dev). In Docker la imposta docker-compose.yml.
DATABASE_URL=postgres://garage:garage@localhost:5432/garage
POSTGRES_PASSWORD=garage

# Porta e interfaccia esposte da Docker. APP_BIND=0.0.0.0 per accedere dalla LAN.
APP_PORT=3000
APP_BIND=127.0.0.1
